<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页主布局（传统 View 栈，对齐 FunBox）：
  FrameLayout root
    ├─ FrameLayout bgLayer 独立背景层
    │    ├─ ImageView  静态封面（点开瞬间即有画面，Glide 加载）
    │    ├─ WebView    Spine 节令动画背景（透明，铺满，代码里加载）
    │    └─ TextView   资源准备中提示
    └─ ScrollView 卡片列（每张卡一个 BlurView 真毛玻璃）
       关键：BlurView 的采样源是 bgLayer 而不是整个 root ——
       快照里只可能存在背景内容，卡片/图标/UI 残影永远混不进毛玻璃。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bgLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/bgCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <WebView
            android:id="@+id/bgAnim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="背景资源准备中…"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- 标题卡：logo + 名称 -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_frosted_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="26dp"
                    android:paddingBottom="26dp">

                    <FrameLayout
                        android:id="@+id/logoChip"
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Q"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="QOdeep"
                        android:textColor="#1A1A1A"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="QQ 功能增强模块"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- 更换背景卡：chip + 标题/副标题 + 当前值 + 箭头 -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_frosted_card">

                <LinearLayout
                    android:id="@+id/bgRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:id="@+id/chipBg"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="更换背景"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="节令动态海报（骨骼动画），点击选择"
                            android:textColor="#9AA0A6"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCurrentBg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="›"
                        android:textColor="#C0C4CC"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- DexKit 缓存卡：状态行 + 重建入口 + 说明 -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardDexkit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_frosted_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/chipDex"
                            android:layout_width="40dp"
                            android:layout_height="40dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DexKit 缓存"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvDexDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#9AA0A6"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDexReady"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="读取中..."
                            android:textColor="#34C759"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dexRebuildRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvRebuild"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="重建 DexKit 缓存"
                            android:textColor="#222222"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#B0B0B0"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除缓存并重新扫描，完成后重启 QQ 生效"
                        android:textColor="#FF9500"
                        android:textSize="12sp" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
