<?xml version="1.0" encoding="utf-8"?>
<!-- 毛玻璃卡片底：半透明白渐变 + 白描边 + 22dp 圆角。
     叠在 BlurView 的实时模糊层之上形成磨砂质感；圆角同时决定 BlurView 的 outline 裁剪。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E6FFFFFF"
        android:endColor="#B3FFFFFF" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
